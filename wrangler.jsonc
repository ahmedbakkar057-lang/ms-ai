{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reckless-ms-api",
  "main": "main.py",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["python_workers"],
  "kv_namespaces": [
    {
      "binding": "FACTS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
